{
  "name": "doprava-cesko",
  "version": "0.10.0",
  "private": true,
  "description": "Doprava — Celé Česko: prémiová dopravní webová aplikace (Next.js + MapLibre). První integrace: PID.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/build-assets.mjs",
    "verify:golemio": "node scripts/verify-golemio.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "icons": "node scripts/build-icons.mjs",
    "import:stops": "node scripts/import-pid-stops.mjs",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "start:standalone": "node .next/standalone/server.js"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@types/three": "^0.186.0",
    "fast-xml-parser": "^5.11.2",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
