# Živá data PID přes Golemio API. Klíč vygenerujte na https://api.golemio.cz/api-keys (zdarma, registrace).
# Klíč zůstává pouze na serveru – nikdy ho neprefixujte NEXT_PUBLIC_.
GOLEMIO_API_KEY=

# Mapový styl MapLibre (běhová konfigurace serveru). Výchozí: OpenFreeMap Liberty (bez klíče, nutné uvedení zdroje – zobrazuje se automaticky).
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Další povolené domény pro mapový podklad v CSP (při sestavení), např. vlastní hostované dlaždice.
MAP_EXTRA_ORIGINS=

# Plánovač spojení: GraphQL endpoint OpenTripPlanneru 2.x (GTFS GraphQL API), např. http://localhost:8080/otp/gtfs/v1
OTP_GRAPHQL_URL=

# Ukázková data pouze pro vývoj a testy. V produkci nechte prázdné; UI je pak zřetelně označí.
DEMO_DATA=

# Token pro chráněnou diagnostiku /api/admin/health (Authorization: Bearer ...). Prázdné = diagnostika vypnuta.
ADMIN_TOKEN=

# Plánovač spojení: bez OTP_GRAPHQL_URL se použije veřejné API Transitous (https://transitous.org/api/).
# PLANNER=off plánovač vypne (např. pro komerční provoz bez dohody s Transitous).
# PLANNER=off
